#include "containers/tmplhead.fh"

      implicit none

      private
      public :: __TMPL(vector)

      type __TMPL(vector)
        private
        _entry, dimension(:), allocatable :: vbuffer
        integer :: vsize=0
      contains
        procedure :: getsize
        procedure :: empty
        procedure :: at
        procedure :: getdata
        procedure :: back
        procedure :: set
        procedure :: copy
        procedure :: push_back
        procedure :: pop_back
        procedure :: resize
        procedure :: clear
        procedure :: reserve
        procedure :: swap
        procedure :: reset
        generic, public :: assignment(=) => copy
#ifdef EQUAL_DEFINED
        procedure :: getindex
        procedure :: equal
        generic, public :: operator(==) => equal
#endif
      end type __TMPL(vector)

      contains

! =======================
!  getsize
! =======================
      pure function getsize(this) result(res)
      implicit none
      class(__TMPL(vector)), intent(in) :: this
      integer :: res

      res=this%vsize
      return
      end function getsize


! =======================
!  empty
! =======================
      pure function empty(this) result(res)
      implicit none
      class(__TMPL(vector)), intent(in) :: this
      logical :: res

      res=this%vsize==0
      return
      end function empty


! =======================
!  at
! =======================
      function at(this, i) result(res)
      implicit none
      class(__TMPL(vector)), target, intent(in) :: this
      integer, intent(in) :: i
      _entry, pointer :: res

      res=>this%vbuffer(i)
      return
      end function at


! =======================
!  getdata
! =======================
      function getdata(this) result(res)
      implicit none
      class(__TMPL(vector)), target, intent(in) :: this
      _entry, dimension(:), pointer :: res

      res=>this%vbuffer(:this%vsize)
      return
      end function getdata


! =======================
!  back
! =======================
      function back(this) result(res)
      implicit none
      class(__TMPL(vector)), target, intent(in) :: this
      _entry, pointer :: res

      res=>this%vbuffer(this%vsize)
      return
      end function back


! =======================
!  set
! =======================
      subroutine set(this, i, value)
      implicit none
      class(__TMPL(vector)), intent(inout) :: this
      integer, intent(in) :: i
      _entry, intent(in) :: value

      this%vbuffer(i)=value
      return
      end subroutine set


! =======================
!  reset
! =======================
      subroutine reset(this)
      implicit none
      class(__TMPL(vector)), intent(inout) :: this

      if (allocated(this%vbuffer)) then
        deallocate(this%vbuffer)
      end if
      this%vsize=0
      return
      end subroutine reset


! =======================
!  copy
! =======================
      subroutine copy(this, other)
      implicit none
      class(__TMPL(vector)), intent(inout) :: this
      class(__TMPL(vector)), intent(in) :: other

      call this%resize(other%vsize)
      this%vbuffer(1:this%vsize)=other%vbuffer(1:this%vsize)
      return
      end subroutine copy


#ifdef EQUAL_DEFINED
! =======================
!  getindex
! =======================
      pure function getindex(this, value) result(i)
      implicit none
      class(__TMPL(vector)), target, intent(in) :: this
      _entry, intent(in) :: value
      integer :: i

      do i=1, this%vsize
        if (this%vbuffer(i)==value) return
      end do
      i=0
      return
      end function getindex


! =======================
!  equal
! =======================
      pure function equal(this, other) result(res)
      implicit none
      class(__TMPL(vector)), intent(in) :: this, other
      logical :: res
      integer :: i

      res=this%vsize==other%vsize
      if (res) then
        res=.false.
        do i=1, this%vsize
          if (.not.(this%vbuffer(i)==other%vbuffer(i))) return
        end do
        res=.true.
      endif
      return
      end function equal
#endif

! =======================
!  copyarray
! =======================
      subroutine copyarray(this, array)
      implicit none
      class(__TMPL(vector)), intent(inout) :: this
      _entry, dimension(:), intent(in) :: array

      call this%resize(size(array))
      this%vbuffer(1:this%vsize)=array(1:this%vsize)
      return
      end subroutine copyarray


! =======================
!  push_back
! =======================
      subroutine push_back(this, value)
      implicit none
      class(__TMPL(vector)), intent(inout) :: this
      _entry, intent(in) :: value

      if (.not.allocated(this%vbuffer)) then
        call this%reserve(1)
      elseif (this%vsize.ge.size(this%vbuffer)) then
        call this%reserve(this%vsize*2)
      endif
      this%vsize=this%vsize+1
      this%vbuffer(this%vsize)=value
      return
      end subroutine push_back


! =======================
!  pop_back
! =======================
      subroutine pop_back(this)
      implicit none
      class(__TMPL(vector)), intent(inout) :: this

      call this%resize(this%vsize-1)
      return
      end subroutine pop_back


! =======================
!  resize
! =======================
      subroutine resize(this, newsize, value)
      implicit none
      class(__TMPL(vector)), intent(inout) :: this
      integer, intent(in) :: newsize
      _entry, intent(in), optional :: value
      integer :: oldsize

      if (newsize==this%vsize) return
      if (newsize<0) stop 'vector resize: negative size'
      oldsize=this%vsize
      if (.not.allocated(this%vbuffer).or.(size(this%vbuffer)<newsize)) &
     &                      call this%reserve(newsize)
      this%vsize=newsize
      if (present(value).and.(newsize>oldsize))                         &
     &                   this%vbuffer(oldsize+1:newsize)=value
      return
      end subroutine resize


! =======================
!  clear
! =======================
      subroutine clear(this)
      implicit none
      class(__TMPL(vector)), intent(inout) :: this

      call this%resize(0)
      return
      end subroutine clear


! =======================
!  reserve
! =======================
      subroutine reserve(this, capacity)
      implicit none
      class(__TMPL(vector)), intent(inout) :: this
      integer, intent(in) :: capacity
      _entry, dimension(:), allocatable :: temp

      if (capacity<0) stop 'vector reserve: negative size'
      if (this%vsize>capacity) return
      if (.not.allocated(this%vbuffer).and.(capacity>0)) then
        allocate(this%vbuffer(capacity))
      elseif (allocated(this%vbuffer).and.(capacity==0)) then
        deallocate(this%vbuffer)
      elseif (size(this%vbuffer)/=capacity) then
        allocate(temp(capacity))
        temp(1:this%vsize)=this%vbuffer(1:this%vsize)
        call move_alloc(temp, this%vbuffer)
      endif
      return
      end subroutine reserve


! =======================
!  swap
! =======================
      subroutine swap(this, other)
      implicit none
      class(__TMPL(vector)), intent(inout) :: this
      type(__TMPL(vector)), intent(inout) :: other
      _entry, dimension(:), allocatable :: tmpbuffer
      integer :: tmpsize

      call move_alloc(this%vbuffer, tmpbuffer)
      call move_alloc(other%vbuffer, this%vbuffer)
      call move_alloc(tmpbuffer, other%vbuffer)
      tmpsize=this%vsize
      this%vsize=other%vsize
      other%vsize=tmpsize
      return
      end subroutine swap

#include "containers/tmpltail.fh"
